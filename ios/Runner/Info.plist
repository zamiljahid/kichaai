	<!-- iOS OAuth client for bundle com.kichaai.app in Firebase project ki-chaai
	     (635941830068). The previous value belonged to project 722468376620, an
	     unrelated GCP project this app has no client in, so the iOS SDK could
	     never mint a usable token. Must stay in the same project as the Android
	     client and the web serverClientId in AuthService. -->
	<key>GIDClientID</key>
	<string>635941830068-6r3qrip9832datf0p11ef8kabf36lqsg.apps.googleusercontent.com</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- iOS crashes the app outright if a permission is requested without its purpose
	     string, and App Store review rejects a build that is missing one. Written so a
	     reviewer and a Bengali user both understand why it is being asked. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>আপনার কাছের সেবাদাতা খুঁজতে, রাইডের পিক-আপ ঠিক করতে আর চলতি কাজ ট্র্যাক করতে লোকেশন লাগে। — KiChaai uses your location to find nearby providers, set your ride pickup and track a job in progress.</string>
	<key>NSCameraUsageDescription</key>
	<string>কাজের ছবি, এনআইডি আর পোর্টফোলিও তুলতে ক্যামেরা লাগে। — KiChaai uses the camera to take job photos, NID pictures and portfolio images.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>গ্যালারি থেকে কাজের ছবি, এনআইডি বা পোর্টফোলিও বেছে নিতে অ্যাক্সেস লাগে। — KiChaai needs access to pick job photos, NID pictures or portfolio images from your gallery.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>KiChaai uses your microphone so you can speak your legal issue to the AI assistant instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>KiChaai converts your speech to text so the lawyer AI assistant can understand your issue.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kichaai.google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.635941830068-6r3qrip9832datf0p11ef8kabf36lqsg</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kichaai.meal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Meal Group invite links (kichaai://meal/join/<code>) — custom-scheme only
					 (Phase 1); real iOS Universal Links need a hosted apple-app-site-association
					 on kichaai.com, deferred until the founder sets that up. -->
				<string>kichaai</string>
			</array>
		</dict>
	</array>
</dict>
